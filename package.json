{
  "name": "kraflr-agent",
  "version": "1.0.0",
  "private": true,
  "description": "A terminal workspace for authorized security research with Claude Code, OpenCode and Cline.",
  "license": "Apache-2.0",
  "author": "Plexavo Labs",
  "homepage": "https://kraflragent.plexavo.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plexavo/kraflr-agent.git"
  },
  "bugs": "https://github.com/plexavo/kraflr-agent/issues",
  "type": "module",
  "bin": {
    "kraflr": "bin/kraflr.mjs"
  },
  "packageManager": "pnpm@12.21.0",
