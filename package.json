  "dependencies": {
    "@agentclientprotocol/sdk": "2.12.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@xterm/headless": "6.0.0",
    "fastify": "5.12.8",
    "node-pty": "1.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.10",
    "typescript": "7.0.2"
  }
}
